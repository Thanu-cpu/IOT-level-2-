void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "   ESP32-CAM SECURITY SYSTEM"
  );

  Serial.println(
    "================================"
  );

  Serial.printf(
    "Initial free heap: %u\n",
    ESP.getFreeHeap()
  );

  // ----------------------------------------------------------
  // GPIO
  // ----------------------------------------------------------

  pinMode(
    PIR_PIN,
    INPUT
  );

  pinMode(
    BUZZER_PIN,
    OUTPUT
  );

  digitalWrite(
    BUZZER_PIN,
    LOW
  );

  // ----------------------------------------------------------
  // CAMERA
  // ----------------------------------------------------------

  setupCamera();

  if (!cameraOK) {

    Serial.println();
    Serial.println(
      "CAMERA FAILED."
    );

    Serial.println(
      "Check ESP32-CAM board/pin configuration."
    );

    return;
  }

  // ----------------------------------------------------------
  // WIFI + BLYNK
  // ----------------------------------------------------------

  Serial.println();
  Serial.println(
    "Connecting to Blynk..."
  );

  Blynk.begin(
    BLYNK_AUTH_TOKEN,
    ssid,
    pass,
    BLYNK_SERVER,
    80
  );

  Serial.println(
    "Blynk connected."
  );

  printNetworkInfo();

  // ----------------------------------------------------------
  // STREAM SERVER
  // ----------------------------------------------------------

  startStreamServer();

  // ----------------------------------------------------------
  // PIR TIMER
  // ----------------------------------------------------------

  timer.setInterval(
    200L,
    checkPIR
  );

  // Memory monitor
  timer.setInterval(
    10000L,
    printMemory
  );

  Serial.println();
  Serial.println(
    "System ARMED."
  );

  Serial.println(
    "Waiting for motion..."
  );

  Serial.printf(
    "Final free heap: %u\n",
    ESP.getFreeHeap()
  );
}

